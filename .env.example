# local | development | production. Use local/development on your PC.
# production only on Vercel main. Legacy "staging" is treated as local/non-production.
NEXT_PUBLIC_APP_ENV=local

# Stable public site URL used in inactivity / late-login email links.
# Prefer an explicit value. Local example: http://localhost:3000
# Production: https://madiba-sfa.vercel.app
# Do not set this to a unique Vercel deployment host.
APP_ORIGIN=http://localhost:3000

# Use local/dev Supabase credentials only in .env.local.
# Never use production Supabase URL or keys on your PC.
# Local runtimes fail fast if NEXT_PUBLIC_SUPABASE_URL is the production project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_LOCAL_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_SUPABASE_SERVICE_ROLE_KEY
# Emergency only (do not use casually): MADIBA_ALLOW_PRODUCTION_SUPABASE=1

# Generate a different secret for each environment.
CRON_SECRET=YOUR_RANDOM_CRON_SECRET

# Firebase service account JSON (single line) for server-side FCM push.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID"}

# Optional. The application has a fallback source URL when this is omitted.
PRICE_SOURCE_URL=

# Optional. Pre-fill WhatsApp share with a manager/group number for collection visit summaries.
NEXT_PUBLIC_COLLECTION_WHATSAPP_NUMBER=

# Daily visit report emails at 00:10 KSA. One email per user.
# Use SMTP or Resend. SMTP_FROM is required for both.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
# Extra inbox that receives every user's report (managers). Comma-separated.
DAILY_VISIT_REPORT_TO=
# Set to false to email only DAILY_VISIT_REPORT_TO, not each user's profile email.
DAILY_VISIT_REPORT_SEND_TO_USERS=true

# Daily salesman resume table email at 00:15 KSA (previous KSA day).
# Always includes malik@pinasz.com, soyeb@noorshukran.com, and fazlur.rahiman@noorshukran.com.
# Extra addresses can be added here, comma-separated.
DAILY_SALESMAN_RESUME_TO=malik@pinasz.com,soyeb@noorshukran.com,fazlur.rahiman@noorshukran.com

# 50-minute inactivity emails and 11:00 KSA late-login reminders
# (user + reporting-chain bosses, every 30 minutes until login)
# run with /api/cron/inactivity-push. Uses SMTP_* / RESEND_API_KEY above.

# Submitted orders from September 2026 still missing an invoice 1 hour after creation.
# Sent every 15 minutes, Saturday–Thursday 9:00 AM–8:00 PM IST, via /api/cron/missing-invoice-email.
# Primary schedule is Supabase pg_cron; GitHub Actions is the backup. The first authorized
# cron run stores CRON_SECRET in Vault so Postgres can keep calling this endpoint.
# Always includes the default invoice-ops To list and jenil.modi@noorshukran.com,
# soyeb@noorshukran.com, and fazlur.rahiman@noorshukran.com on CC.
# Extra addresses can be added here.
MISSING_INVOICE_EMAIL_TO=
MISSING_INVOICE_EMAIL_CC=

# Daily order confirmation at 00:20 KSA via GitHub Actions + /api/cron/daily-supplier-order-email.
# Each salesman gets their orders (all invoice statuses) with hierarchy bosses on CC.
# Also runs after each sales Excel upload (/api/import-sales).
# Extra digest addresses can be added here (defaults include the invoice-ops list).
DAILY_SUPPLIER_ORDER_EMAIL_TO=
DAILY_SUPPLIER_ORDER_EMAIL_CC=
# Set to false to send only the combined digest, not each salesman's copy.
DAILY_SUPPLIER_ORDER_EMAIL_SEND_TO_USERS=true

# Daily Outstanding Without GPS reminder at 00:25 KSA via GitHub Actions +
# /api/cron/outstanding-no-gps-email. Each salesman gets their customers with
# outstanding balance and no saved GPS; hierarchy bosses are on CC.
# Optional management digest (comma-separated).
OUTSTANDING_NO_GPS_EMAIL_TO=
OUTSTANDING_NO_GPS_EMAIL_CC=
# Set to false to send only the management digest, not each salesman's copy.
OUTSTANDING_NO_GPS_EMAIL_SEND_TO_USERS=true

# Salesman visit plan (/management/salesman-visit-plan).
# Midnight KSA cron builds and stores the snapshot; the page only reads that saved plan.
NEXT_PUBLIC_SALESMAN_VISIT_PLAN_SALESMAN_ACCESS=true
# Cron /api/cron/salesman-visit-plan-email at 00:00 KSA (GitHub Actions).
# Keep false until visit-plan scoring/list is finalized.
SALESMAN_VISIT_PLAN_EMAIL_ENABLED=false
SALESMAN_VISIT_PLAN_EMAIL_SEND_TO_USERS=false
# Admin digest inbox (always includes malik@pinasz.com). Comma-separated extras allowed.
SALESMAN_VISIT_PLAN_EMAIL_TO=malik@pinasz.com

# Minimum Android APK build required for native app login. Set to 0 to disable.
MIN_ANDROID_APK_VERSION_CODE=0
MIN_ANDROID_APK_VERSION_NAME=
ANDROID_APK_DOWNLOAD_URL=