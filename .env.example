# Set to staging in the shared developer/UAT deployment and production in live.
NEXT_PUBLIC_APP_ENV=staging

# Stable public site URL used in inactivity / late-login email links.
# Do not set this to a unique Vercel deployment host.
APP_ORIGIN=https://madiba-sfa.vercel.app

# Use credentials from the matching Supabase project. Never use production
# credentials in staging.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_STAGING_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY

# Generate a different secret for each environment.
CRON_SECRET=YOUR_RANDOM_CRON_SECRET

# Firebase service account JSON (single line) for server-side FCM push.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID"}

# Optional. The application has a fallback source URL when this is omitted.
PRICE_SOURCE_URL=

# Optional. Pre-fill WhatsApp share with a manager/group number for collection visit summaries.
NEXT_PUBLIC_COLLECTION_WHATSAPP_NUMBER=

# Daily visit report emails at 00:10 KSA. One email per user.
# Use SMTP or Resend. SMTP_FROM is required for both.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=
# Extra inbox that receives every user's report (managers). Comma-separated.
DAILY_VISIT_REPORT_TO=
# Set to false to email only DAILY_VISIT_REPORT_TO, not each user's profile email.
DAILY_VISIT_REPORT_SEND_TO_USERS=true

# Daily salesman resume table email at 00:15 KSA (previous KSA day).
# Always includes malik@pinasz.com, soyeb@noorshukran.com, and fazlur.rahiman@noorshukran.com.
# Extra addresses can be added here, comma-separated.
DAILY_SALESMAN_RESUME_TO=malik@pinasz.com,soyeb@noorshukran.com,fazlur.rahiman@noorshukran.com

# 40-minute inactivity emails and 11:00 KSA late-login reminders
# (user + reporting-chain bosses, every 30 minutes until login)
# run via Vercel Cron on /api/cron/inactivity-push every 10 minutes.
# Uses SMTP_* / RESEND_API_KEY above. Requires CRON_SECRET on Vercel.

# Submitted orders from September 2026 still missing an invoice 1 hour after creation.
# Sent every 15 minutes, Saturday–Thursday 9:00 AM–8:00 PM IST, via /api/cron/missing-invoice-email.
# Primary schedule is Supabase pg_cron; GitHub Actions is the backup. The first authorized
# cron run stores CRON_SECRET in Vault so Postgres can keep calling this endpoint.
# Always includes the default invoice-ops To list and jenil.modi@noorshukran.com on CC.
# Extra addresses can be added here.
MISSING_INVOICE_EMAIL_TO=
MISSING_INVOICE_EMAIL_CC=

# Daily order confirmation at 00:20 KSA (previous KSA day) via /api/cron/daily-supplier-order-email.
# Each salesman who raised submitted orders gets their own table (report email + hierarchy).
# A combined digest also goes to the missing-invoice To/CC list. Extra addresses can be added here.
DAILY_SUPPLIER_ORDER_EMAIL_TO=
DAILY_SUPPLIER_ORDER_EMAIL_CC=
# Set to false to send only the combined digest, not each salesman's copy.
DAILY_SUPPLIER_ORDER_EMAIL_SEND_TO_USERS=true

# Minimum Android APK build required for native app login. Set to 0 to disable.
MIN_ANDROID_APK_VERSION_CODE=0
MIN_ANDROID_APK_VERSION_NAME=
ANDROID_APK_DOWNLOAD_URL=