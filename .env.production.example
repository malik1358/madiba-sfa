# Production environment template — copy values into Vercel Project Settings → Environment Variables (Production scope).
# NEVER commit real secrets (.env* files are gitignored except this example).

NEXT_PUBLIC_APP_ENV=production

# --- Supabase (production project) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PRODUCTION-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<prod publishable key>
SUPABASE_SERVICE_ROLE_KEY=<prod service role key>   # server-only, do not expose

# --- KPI pace feature (new in v2026.10.19-kpi-pace) ---
# No new variables required. Personalized pace reads trailing 3 months of
# active_sales rows from the existing SUPABASE_SERVICE_ROLE_KEY connection.
# Verify: the service role key must have SELECT on active_sales and the
# kpi_targets table used by app/lib/performanceKpisServer.js.

# --- Firebase (push notifications) ---
FIREBASE_SERVICE_ACCOUNT_JSON=<single-line JSON, prod project>

# --- Cron protection ---
CRON_SECRET=<long random string; also set identically in Vercel Cron jobs header>

# --- Email / reports ---
SMTP_HOST=smtp.<your-provider>.com
SMTP_PORT=587
SMTP_USER=<smtp user>
SMTP_PASS=<smtp pass>
SMTP_FROM="Madiba SFA <no-reply@yourdomain.com>"
RESEND_API_KEY=<optional, if using Resend>
DAILY_VISIT_REPORT_TO=<report recipients>
DAILY_SALESMAN_RESUME_TO=<recipients>

# --- Android APK minimum version gate ---
MIN_ANDROID_APK_VERSION_CODE=0
ANDROID_APK_DOWNLOAD_URL=<play store or direct link>
